
WEATHERAPI_API_KEY=

# Azure Event Hubs Configuration
# Azure Portal'dan Event Hubs namespace'i oluşturduktan sonra connection string'i alın
AZURE_EVENT_HUB_CONNECTION_STRING=
AZURE_EVENT_HUB_NAME=weatherdatahub

# MongoDB Configuration
# Yerel MongoDB: 
# MongoDB Atlas: 
MONGODB_URI=

# Data Collection Settings
# Veri toplama aralığı (milisaniye cinsinden)
# 300000 = 5 dakika, 60000 = 1 dakika
DATA_COLLECTION_INTERVAL=300000

# Server Configuration
PORT=3001

# Log Level (INFO, WARN, ERROR)
LOG_LEVEL=INFO
NODE_ENV=development

